# ---------------------------------------------------------------------------
# Fleet Management System – Third-party Integrations, API Gateway
# Author : Ashfaaq Feroz Muhammad | BITS ID: 2023EBCS005
# Copy this file to .env  (cp .env.example .env). Never commit .env.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Leave EMPTY to use the built-in local database (mongodb-memory-server,
# data kept in ./.data/mongo). Set an Atlas/local URI for a real MongoDB,
# e.g. mongodb+srv://user:pass@cluster0.xxxx.mongodb.net/?retryWrites=true
MONGO_URI=

# --- Security -------------------------------------------------------------
# Secret used to sign/verify JWTs (shared by every service). Change it!
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h
# Token that services send to each other in the x-internal-token header
INTERNAL_SERVICE_TOKEN=change-me-internal-service-token

# --- API Gateway ----------------------------------------------------------
GATEWAY_PORT=8080
# Comma separated  key:tier  pairs. Tiers: standard | premium | demo
# (demo has a tiny limit so you can show a 429 after a few requests)
API_KEYS=devkey123:standard,partnerkey456:premium,demokey789:demo
# Rate limit window (ms) and max requests per key per window
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_MAX_PREMIUM=1000
RATE_LIMIT_MAX_DEMO=5
# How long the gateway waits for a backend service before returning 503 (ms)
PROXY_TIMEOUT_MS=10000

# --- Service ports & URLs (the gateway and services use these) ------------
USER_SERVICE_PORT=4001
VEHICLE_SERVICE_PORT=4002
TELEMETRY_SERVICE_PORT=4003
GEO_SERVICE_PORT=4004
NOTIFICATION_SERVICE_PORT=4005
USER_SERVICE_URL=http://localhost:4001
VEHICLE_SERVICE_URL=http://localhost:4002
TELEMETRY_SERVICE_URL=http://localhost:4003
GEO_SERVICE_URL=http://localhost:4004
NOTIFICATION_SERVICE_URL=http://localhost:4005

# --- Geolocation ----------------------------------------------------------
# nominatim (OpenStreetMap, free, no key) | google | mock (offline, for tests)
GEO_PROVIDER=nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Nominatim's usage policy asks for an identifying User-Agent. You may add
# your own contact (e.g. a GitHub URL) inside the brackets.
NOMINATIM_USER_AGENT=FleetManagementSystem/1.0 (BITS Pilani student project)
GOOGLE_MAPS_API_KEY=
# Optional second provider, used only when the primary one fails (e.g. Nominatim
# answering 429 to a shared cloud IP). Responses then carry fallbackFrom/fallbackReason
# and are not cached. Leave empty locally; render.yaml sets it to mock.
GEO_FALLBACK_PROVIDER=

# --- SMS ------------------------------------------------------------------
# stub (default – prints and stores messages) | twilio (Twilio sandbox)
SMS_PROVIDER=stub
# Probability (0–1) that the stub randomly fails. Numbers ending in 0000
# ALWAYS fail, so failures are easy to demo.
SMS_STUB_FAIL_RATE=0
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Telemetry thresholds for auto-detected critical events ---------------
LOW_BATTERY_VOLTAGE=11.5
ENGINE_TEMP_MAX=110

# --- Logging --------------------------------------------------------------
LOG_LEVEL=info
