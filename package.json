    "test:vehicles": "mocha test/flows/02-vehicles.flow.js",
    "test:telemetry": "mocha test/flows/03-telemetry.flow.js",
    "test:status": "mocha test/flows/04-status-notifications.flow.js",
    "test:rbac": "mocha test/flows/05-rbac.flow.js",
